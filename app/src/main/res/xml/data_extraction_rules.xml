<?xml version="1.0" encoding="utf-8"?>
<!-- trackId são _IDs do MediaStore, válidos só neste aparelho: o banco fica fora de backup e transferência. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="resonance.db" />
        <exclude domain="database" path="resonance.db-wal" />
        <exclude domain="database" path="resonance.db-shm" />
        <exclude domain="database" path="resonance.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="resonance.db" />
        <exclude domain="database" path="resonance.db-wal" />
        <exclude domain="database" path="resonance.db-shm" />
        <exclude domain="database" path="resonance.db-journal" />
    </device-transfer>
</data-extraction-rules>
